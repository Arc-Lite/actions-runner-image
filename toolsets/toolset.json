{
    "toolcache": [
        {
            "name": "Python",
            "url": "https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json",
            "platform": "linux",
            "platform_version": "26.04",
            "arch": "x64",
            "versions": [
                "3.13.*",
                "3.14.*",
                "3.15.*"
            ],
            "default": "3.14.*"
        },
        {
